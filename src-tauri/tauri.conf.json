{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SVGA Editor Pro",
  "version": "2.0.0",
  "identifier": "com.svga.editor.pro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SVGA Editor Pro",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["svgaproj"],
        "name": "SVGA Editor Project",
        "description": "Editable SVGA Editor Project",
        "role": "Editor"
      },
      {
        "ext": ["svga"],
        "name": "SVGA Animation",
        "description": "SVGA Animation File",
        "role": "Editor"
      }
    ]
  }
}
